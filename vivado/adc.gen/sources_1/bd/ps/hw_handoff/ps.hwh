    <MODULE COREREVISION="37" FULLNAME="/gpio_led" HWVERSION="2.0" INSTANCE="gpio_led" IPTYPE="PERIPHERAL" IS_ENABLE="1" MODCLASS="PERIPHERAL" MODTYPE="axi_gpio" VLNV="xilinx.com:ip:axi_gpio:2.0">
