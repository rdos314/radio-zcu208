    <MODULE COREREVISION="37" FULLNAME="/clk104_mux" HWVERSION="2.0" INSTANCE="clk104_mux" IPTYPE="PERIPHERAL" IS_ENABLE="1" MODCLASS="PERIPHERAL" MODTYPE="axi_gpio" VLNV="xilinx.com:ip:axi_gpio:2.0">
